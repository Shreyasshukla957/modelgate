PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/modelgate
ADMIN_API_KEY=replace-with-a-long-random-secret
GATEWAY_KEY_PEPPER=replace-with-a-different-long-random-secret
GEMINI_API_KEY=replace-with-provider-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=
REQUEST_TIMEOUT_MS=60000
# Choose one Redis connection format. Leave all Redis values blank to disable the optional burst limit.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# Set these to the current rates for the models configured above before deployment.
PRIMARY_INPUT_COST_PER_1M_USD=0.75
PRIMARY_OUTPUT_COST_PER_1M_USD=3.75
# Required when FALLBACK_MODEL is set. Use 0 only for an intentionally free model.
FALLBACK_INPUT_COST_PER_1M_USD=
FALLBACK_OUTPUT_COST_PER_1M_USD=
