{
  "name": "modelgate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "build:ui": "vite build --config frontend/vite.config.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "npm run build && node tests/integration/run.mjs",
    "seed:key": "tsx src/scripts/create-key.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "mongoose": "^8.9.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^4.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
